export function normalizeEmail(raw: string | null): string | null {
  if (raw == null) return null;

  const trimmed = raw.trim();
  const m = trimmed.match(/^([^@\s]+)@([^@\s]+)$/);

  if (m == null) return null;

  return `${m[1]}@${m[2]}`;
}
```

